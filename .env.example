# app (optional — defaults apply if omitted)
APP_NAME=miniflake
ENVIRONMENT=local
LOG_LEVEL=INFO
HEALTH_VERSION=0.1.0

# snowflake (required)
SNOWFLAKE_ACCOUNT=ABCDEF-123456
SNOWFLAKE_USER=USER_SVC
SNOWFLAKE_ROLE=USER_READONLY
SNOWFLAKE_WAREHOUSE=WAREHOUSE_WH
SNOWFLAKE_DATABASE=US_OPEN_CENSUS_DATA_NEIGHBORHOOD_INSIGHTS_FREE_DATASET
# Provide SNOWFLAKE_PRIVATE_KEY_PATH or SNOWFLAKE_PRIVATE_KEY (not both)
SNOWFLAKE_PRIVATE_KEY_PATH=C:/Users/john/.miniflake/rsa_key.p8

# snowflake (optional)
# SNOWFLAKE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_STATEMENT_TIMEOUT_SECONDS=60
SNOWFLAKE_QUERY_TAG=miniflake
SNOWFLAKE_MAX_ROWS=1000
SNOWFLAKE_RETRY_ATTEMPTS=3
SNOWFLAKE_RETRY_BACKOFF_SECONDS=0.5

# data layer (optional)
REPOSITORY_SEARCH_LIMIT=25
ACS_VINTAGES=2019,2020
NATION_GEO_ID=US
ACS_WIDE_TABLE_TEMPLATE={vintage}_CBG_{series_prefix}
METADATA_FIELD_DESCRIPTIONS_TEMPLATE={vintage}_METADATA_CBG_FIELD_DESCRIPTIONS
METADATA_FIPS_CODES_TEMPLATE={vintage}_METADATA_CBG_FIPS_CODES
METADATA_GEOGRAPHIC_DATA_TEMPLATE={vintage}_METADATA_CBG_GEOGRAPHIC_DATA
FIXTURES_DIR=fixtures
VARIABLE_CATALOG_SPEC_PATH=fixtures/variable_catalog_spec.yaml
STATE_FIPS_NAMES_PATH=fixtures/state_fips_names.json

# gcp (optional — deploy only)
GCP_PROJECT=your-gcp-project
GCP_REGION=your-gcp-region
GCP_ARTIFACT_REPO=miniflake
GCP_SERVICE_NAME=miniflake
