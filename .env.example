# app (optional — defaults apply if omitted)
APP_NAME=miniflake
ENVIRONMENT=local
LOG_LEVEL=INFO
# LOG_FORMAT=json
# LOG_FILE=logs/app.jsonl
# Empty LOG_FILE disables the file sink
# LOG_MESSAGE_PREVIEW_CHARS=120
HEALTH_VERSION=0.1.0

# snowflake (required)
SNOWFLAKE_ACCOUNT=ABCDEF-123456
SNOWFLAKE_USER=USER_SVC
SNOWFLAKE_ROLE=USER_READONLY
SNOWFLAKE_WAREHOUSE=WAREHOUSE_WH
SNOWFLAKE_DATABASE=US_OPEN_CENSUS_DATA_NEIGHBORHOOD_INSIGHTS_FREE_DATASET
# Provide SNOWFLAKE_PRIVATE_KEY_PATH or SNOWFLAKE_PRIVATE_KEY (not both)
SNOWFLAKE_PRIVATE_KEY_PATH=C:/Users/john/.miniflake/rsa_key.p8

# snowflake (optional)
# SNOWFLAKE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_STATEMENT_TIMEOUT_SECONDS=60
SNOWFLAKE_QUERY_TAG=miniflake
SNOWFLAKE_MAX_ROWS=1000
SNOWFLAKE_RETRY_ATTEMPTS=3
SNOWFLAKE_RETRY_BACKOFF_SECONDS=0.5

# data layer (optional)
REPOSITORY_SEARCH_LIMIT=25
ACS_VINTAGES=2019,2020
NATION_GEO_ID=US
ACS_WIDE_TABLE_TEMPLATE={vintage}_CBG_{series_prefix}
METADATA_FIELD_DESCRIPTIONS_TEMPLATE={vintage}_METADATA_CBG_FIELD_DESCRIPTIONS
METADATA_FIPS_CODES_TEMPLATE={vintage}_METADATA_CBG_FIPS_CODES
METADATA_GEOGRAPHIC_DATA_TEMPLATE={vintage}_METADATA_CBG_GEOGRAPHIC_DATA
FIXTURES_DIR=fixtures
VARIABLE_CATALOG_SPEC_PATH=fixtures/variable_catalog_spec.yaml
STATE_FIPS_NAMES_PATH=fixtures/state_fips_names.json

# gcp (optional — deploy only)
GCP_PROJECT=your-gcp-project
GCP_REGION=your-gcp-region
GCP_ARTIFACT_REPO=miniflake
GCP_SERVICE_NAME=miniflake

# anthropic (required for live agent and CLI; optional for unit tests)
ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5
# ANTHROPIC_MAX_TOKENS=4096
# ANTHROPIC_EFFORT=low
# ANTHROPIC_THINKING=adaptive
# ANTHROPIC_TIMEOUT_SECONDS=30

# agent (optional)
# AGENT_MAX_ITERATIONS=8
# AGENT_BUDGET_SECONDS=45
# AGENT_MIN_SECONDS_PER_LLM_CALL=5
# AGENT_LLM_RETRY_ENABLED=true

# guardrails (optional)
# GUARDRAIL_CLASSIFIER_ENABLED=true
# GUARDRAIL_CLASSIFIER_CONFIDENCE_THRESHOLD=0.7
# GUARDRAIL_CLASSIFIER_TIMEOUT_SECONDS=5
# GUARDRAIL_CLASSIFIER_CONTEXT_TURNS=2
# GUARDRAIL_CLASSIFIER_THINKING=disabled

# conversation and api (optional)
# RESPONSE_BUDGET_SECONDS=60
# API_TIMEOUT_MARGIN_SECONDS=2
# CONVERSATION_TTL_SECONDS=3600
# CONVERSATION_MAX_TURNS=20
# CONVERSATION_HISTORY_WINDOW_TURNS=10
# CONVERSATION_MAX_CONVERSATIONS=1000
# MAX_MESSAGE_CHARS=4000
# SESSION_COOKIE_NAME=miniflake_session
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax

# demo auth (required when DEMO_AUTH_ENABLED=true, which is the default)
DEMO_AUTH_ENABLED=true
DEMO_PASSPHRASE=your-demo-passphrase
AUTH_SIGNING_SECRET=generate-a-random-secret-at-least-32-chars
# AUTH_COOKIE_NAME=miniflake_auth
# AUTH_COOKIE_MAX_AGE_SECONDS=86400

# deployment (optional)
# WARMUP_ENABLED=true
# SECRET_SNOWFLAKE_PRIVATE_KEY=miniflake-snowflake-private-key
# SECRET_ANTHROPIC_API_KEY=miniflake-anthropic-api-key
# SECRET_AUTH_SIGNING_SECRET=miniflake-auth-signing-secret
# SECRET_DEMO_PASSPHRASE=miniflake-demo-passphrase
# GCP_RUN_SERVICE_ACCOUNT=